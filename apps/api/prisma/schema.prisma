generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  FRONT_OFFICE
  COACHING_STAFF
  PLAYER
  AGENT
  GUARDIAN
}

enum YouthRegistrationStatus {
  PENDING
  GUARDIAN_APPROVED
  CONTRACTED
  REJECTED
}

enum IncidentReportStatus {
  DRAFT
  SUBMITTED
  SIGNED
}

enum IncidentType {
  MATCH
  TRAINING
}

enum CoachingRole {
  HEAD_COACH
  ASSISTANT_COACH
  DEFENSIVE_COACH
  ATTACKING_COACH
  PHYSICAL_COACH
  SET_PIECE_COACH
  GOALKEEPER_COACH
  MEDICAL
  MEDICAL_DIRECTOR
}

enum FrontOfficeRole {
  GM
  TD
  CONTRACT_MANAGER
  SCOUT
  EQUIPMENT_MANAGER
  TACTICAL_ANALYST
}

enum PlayerLevel {
  YOUTH
  ROOKIE
  SENIOR
  VETERAN
}

enum PlayerStatus {
  ACTIVE
  ON_LOAN
  RELEASED
  RETIRED
}

enum Position {
  GOALKEEPER
  STRIKER
  SHADOW_STRIKER
  WINGER
  CENTRAL_ATTACK_MIDFIELDER
  RIGHT_ATTACK_MIDFIELDER
  LEFT_ATTACK_MIDFIELDER
  CENTRAL_DEFENSIVE_MIDFIELDER
  LEFT_DEFENSIVE_MIDFIELDER
  RIGHT_DEFENSIVE_MIDFIELDER
  CENTER_BACK
  LEFT_WING_BACK
  LEFT_FULL_BACK
  RIGHT_WING_BACK
  RIGHT_FULL_BACK
}

enum Foot {
  LEFT
  RIGHT
  BOTH
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  TERMINATED
}

enum BonusMetric {
  GOALS
  ASSISTS
  APPEARANCES
  CLEAN_SHEETS
  SAVES
  PASS_ACCURACY
  TACKLE_SUCCESS_RATE
  CLEARANCES
  INTERCEPTIONS
  XG
  TEAM_RANK
  TEAM_WINS
}

enum BonusPeriod {
  SEASON
  MONTH
  MATCH
}

enum TransferType {
  PERMANENT
  LOAN_OUT
  LOAN_IN
  FREE
  RELEASE
}

enum RecallStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BodyPart {
  HEAD_FACE
  NECK_SHOULDER
  TORSO_BACK
  THIGH_FRONT
  THIGH_BACK
  KNEE
  SHIN_CALF
  ANKLE
  FOOT_TOE
  OTHER
}

enum InjuryCause {
  TRAINING
  MATCH
  OTHER
}

enum InjuryStatus {
  OCCURRED
  DIAGNOSED
  REHABILITATING
  READY_TO_RETURN
  RETURNED
}

enum HospitalType {
  ACCREDITED
  GENERAL
}

enum PartnerType {
  MANUFACTURER
  HOSPITAL
}

enum PartnerContractStatus {
  ACTIVE
  EXPIRED
  TERMINATED
}

enum EquipmentLoanStatus {
  REQUESTED
  APPROVED
  REJECTED
  ISSUED
  RETURNED
}

enum SessionType {
  INDIVIDUAL_SKILL
  TACTICAL_DEFENSIVE
  TACTICAL_ATTACKING
  TACTICAL_FULL_TEAM
  PHYSICAL
  PSYCHOLOGICAL_SOCIAL
  SET_PIECE
  GOALKEEPER
}

enum ContentPhase {
  WARMUP
  DRILL
  TACTICAL
  GAME
}

enum AttendanceStatus {
  PRESENT
  ABSENT_UNAUTHORIZED
  LATE_UNAUTHORIZED
  ABSENT_AUTHORIZED
}

enum TacticalPhase {
  PRE_MATCH
  POST_MATCH
}

enum CompetitionType {
  LEAGUE
  DOMESTIC_CUP
  CONTINENTAL
  PLAYOFF
  FRIENDLY
}

enum Venue {
  HOME
  AWAY
  NEUTRAL
}

enum NotificationType {
  CONTRACT_EXPIRY
  PERFORMANCE_BONUS_ACHIEVED
  INJURY_OCCURRED
  INJURY_READY_TO_RETURN
  INJURY_RETURNED
  SQUAD_DEPTH_LOW
  TRAINING_ATTENDANCE_WARNING
  EQUIPMENT_LOW_STOCK
  EXTENSION_OPTION_AVAILABLE
  EXTERNAL_REPORT_CREATED
  EXTERNAL_REPORT_DUE_SOON
  EXTERNAL_REPORT_OVERDUE
  MEDICAL_EXPENSE_SUBMITTED
  MEDICAL_EXPENSE_LEADER_APPROVED
  MEDICAL_EXPENSE_REJECTED
  MEDICAL_EXPENSE_APPROVED
  REPORT_SUBMITTED
  REPORT_REJECTED
  COACH_AUTO_SHORTLISTED
  COACH_MANUALLY_SHORTLISTED
  COACH_SHORTLISTED
  COACH_APPROVAL_REQUESTED
  COACH_APPROVAL_PENDING
  COACH_CONTRACTED
  COACH_HEAD_CONTRACTED
  COACH_ARCHIVED
  COACH_TUTOR_SUPPORT_NEEDED
  TRAINING_LOAD_ALERT
  PLAYER_DEVELOPMENT_PLAN_ACTIVATED
  PLAYER_CONTRACT_SIGNED
  ATTENDANCE_PENALTY
  TRAINING_SESSION_PENDING
  VIDEO_ASSIGNED
  VIDEO_ASSIGNMENT_OVERDUE
  WORK_PERMIT_EXPIRY_SOON
  CALLUP_REQUESTED
  CALLUP_APPROVED
  CALLUP_REJECTED
  CALLUP_DOCS_READY
  LOAN_OUT_EXPIRED
  TACTICAL_ANALYSIS_CONFIRM_REQUESTED
  JERSEY_NUMBER_CONFLICT
  MATCH_DAY_REMINDER
  ATTENDANCE_UNAUTHORIZED
  ATTENDANCE_PENALTY_PLAYER
  YOUTH_REGISTRATION_STATUS_CHANGED
  YOUTH_WEEKLY_SCHEDULE
  YOUTH_SESSION_CHANGED
  INCIDENT_REPORT_SUBMITTED
  GROWTH_REPORT_PUBLISHED
  SAFEGUARD_EMERGENCY
  FEE_INVOICE_ISSUED
  FEE_REMINDER
  FEE_OVERDUE_WARNING
  FEE_ACCOUNT_LOCKED
}

enum BadgeType {
  PASSION_KING
  SPACE_WIZARD
  BEST_PASSER
  TEAM_PLAYER
  MOST_IMPROVED
  DEFENSIVE_WALL
  GOAL_MACHINE
}

enum TacticalStatus {
  DRAFT
  CONFIRMED
}

enum SeasonStatus {
  UPCOMING
  ACTIVE
  CLOSED
}

enum EquipmentCategory {
  CLOTHING
  FOOTWEAR
  BALL_AND_TOOLS
  REHABILITATION
  TACTICAL
  OTHER
}

enum EquipmentUnitStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  RETIRED
}

enum ProspectStatus {
  ACTIVE
  MEDICAL_TEST
  CONTRACT_PENDING
  SIGNED
  ARCHIVED
}

enum VisaEligibility {
  NOT_REQUIRED
  CONFIRMED
  UNCERTAIN
}

enum WorkPermitStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum TeamType {
  FIRST_TEAM
  YOUTH
}

enum CoachStatus {
  CANDIDATE
  SHORTLISTED
  APPROVAL_PENDING
  CONTRACTED
  RETIRED
  ARCHIVED
}

enum ShortlistSource {
  SYSTEM
  MANUAL
}

enum TutorType {
  INTERNAL
  EXTERNAL
}

enum HiringRoundStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum LanguageProficiency {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum BonusTeamScope {
  ALL
  FIRST_TEAM_ONLY
}

enum PlayerDevelopmentPlanStatus {
  DRAFT
  ACTIVE
  REVIEWED
}

enum JerseyNumberStatus {
  AVAILABLE
  OCCUPIED
  RETIRED
  RESERVED
}

enum MarketValueSource {
  MANUAL
  EXTERNAL_API
}

// ─────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────

model Team {
  id               Int      @id @default(autoincrement())
  name             String
  type             TeamType
  ageGroup         String?
  isActive         Boolean  @default(true)
  isLite           Boolean  @default(false)
  trackStats       Boolean  @default(true)
  requiresContract Boolean  @default(true)
  createdAt        DateTime @default(now())

  players          Player[]
  coachingStaff    User[]
  trainingSessions TrainingSession[]
  matches          Match[]
  coaches          Coach[]
  callupsFrom        PlayerCallup[]    @relation("CallupFromTeam")
  callupsTo          PlayerCallup[]    @relation("CallupToTeam")
  jerseyNumbers      JerseyNumber[]
  youthRegistrations YouthRegistration[]
  incidentReports    IncidentReport[]
}

model Country {
  id   Int    @id @default(autoincrement())
  name String
  code String

  users   User[]
  players Player[]
}

model PhoneNumber {
  id        Int    @id @default(autoincrement())
  iv        String
  encrypted String

  user User?
}

model User {
  id              Int              @id @default(autoincrement())
  email           String           @unique
  password        String
  username        String
  nickname        String           @unique
  role            Role
  coachingRole    CoachingRole?
  frontOfficeRole FrontOfficeRole?
  isDeleted       Boolean          @default(false)
  isOutOfOffice   Boolean          @default(false)
  dateOfBirth     DateTime
  phoneNumberId   Int              @unique
  nationalityId   Int
  teamId          Int?

  phoneNumber              PhoneNumber             @relation(fields: [phoneNumberId], references: [id])
  nationality              Country                 @relation(fields: [nationalityId], references: [id])
  player                   Player?
  recallRequests           Recall[]                @relation("RecallRequestedBy")
  recallApprovals          Recall[]                @relation("RecallApprovedBy")
  managedInjuries          Injury[]
  createdSessions          TrainingSession[]       @relation("TrainingSessionCreatedBy")
  approvedSessions         TrainingSession[]       @relation("TrainingSessionApprovedBy")
  tacticalAnalyses         TacticalAnalysis[]
  notifications            Notification[]
  managedContracts         Contract[]
  agentPlayers             Player[]                @relation("AgentPlayers")
  createdProspects         Prospect[]              @relation("ProspectCreatedBy")
  requestedLoans           EquipmentLoan[]         @relation("LoanRequestedBy")
  approvedLoans            EquipmentLoan[]         @relation("LoanApprovedBy")
  auditLogs                AuditLog[]
  authoredReports          Report[]                @relation("ReportAuthor")
  reviewedReports          Report[]                @relation("ReportReviewer")
  submittedMedicalExpenses MedicalExpense[]        @relation("MedicalExpenseSubmitter")
  leaderReviewedExpenses   MedicalExpense[]        @relation("MedicalExpenseLeaderReviewer")
  adminReviewedExpenses    MedicalExpense[]        @relation("MedicalExpenseAdminReviewer")
  createdInjuryReports     InjuryReport[]          @relation("InjuryReportCreator")
  updatedInjuryReports     InjuryReport[]          @relation("InjuryReportUpdater")
  coachSignedReports       InjuryReport[]          @relation("InjuryReportCoachSigner")
  trainerSignedReports     InjuryReport[]          @relation("InjuryReportTrainerSigner")
  medicalSignedReports     InjuryReport[]          @relation("InjuryReportMedicalSigner")
  assessedInjuries         InjuryAssessment[]
  squadConfirmations       MatchSquad[]       @relation("SquadConfirmations")
  lineupConfirmations      MatchLineup[]      @relation("LineupConfirmations")
  team                     Team?                   @relation(fields: [teamId], references: [id])
  createdHiringRounds      CoachHiringRound[]      @relation("HiringRoundCreatedBy")
  coachProfile             Coach?                  @relation("CoachUser")
  tutorAssignments         CoachTutorAssignment[]  @relation("TutorAssignments")
  scoredTrainingResults    TrainingResult[]        @relation("TrainingResultScorer")
  coachAvailabilities      CoachAvailability[]     @relation("CoachAvailabilityUser")
  createdAvailabilities    CoachAvailability[]     @relation("CoachAvailabilityCreatedBy")
  developmentPlans         PlayerDevelopmentPlan[] @relation("PDPCoach")
  uploadedVideos           TrainingVideo[]         @relation("VideoUploader")
  videoAssignments         VideoAssignment[]       @relation("VideoAssigner")
  trainingReferences       TrainingReference[]
  requestedCallups         PlayerCallup[]          @relation("CallupRequestedBy")
  approvedCallups          PlayerCallup[]          @relation("CallupApprovedBy")
  loginHistory             LoginHistory[]
  recordedMarketValues     MarketValueHistory[]
  guardianPlayers          Player[]                @relation("GuardianPlayers")
  guardianRegistrations    YouthRegistration[]     @relation("GuardianRegistrations")
  youthRegistrations       YouthRegistration[]     @relation("YouthRegistrationRequester")
  reportedIncidents        IncidentReport[]        @relation("IncidentReporter")
  coachEvaluations         GrowthEvaluation[]      @relation("CoachEvaluations")
  awardedBadges            PlayerBadge[]           @relation("CoachBadges")
  isSuspended              Boolean                 @default(false)
  safeguardReportsAccused  SafeguardReport[]       @relation("SafeguardAccused")
  guardianFees             AcademyFee[]            @relation("GuardianFees")
}

model Season {
  id        Int          @id @default(autoincrement())
  name      String
  startDate DateTime
  endDate   DateTime
  status    SeasonStatus @default(UPCOMING)

  matches          Match[]
  trainingSessions TrainingSession[]
  tacticalAnalyses TacticalAnalysis[]
  developmentPlans PlayerDevelopmentPlan[]
}

model Player {
  id               String           @id @default(uuid())
  playerName       String
  dateOfBirth      DateTime
  preferredFoot    Foot
  height           Int
  weight           Int
  position         Position
  level            PlayerLevel
  status           PlayerStatus     @default(ACTIVE)
  externalId       String?          @unique
  nationalityId    Int
  userId           Int?             @unique
  agentId          Int?
  guardianId       Int?
  workPermitStatus WorkPermitStatus @default(NOT_REQUIRED)
  workPermitExpiry DateTime?
  teamId           Int?

  nationality            Country                 @relation(fields: [nationalityId], references: [id])
  user                   User?                   @relation(fields: [userId], references: [id])
  agent                  User?                   @relation("AgentPlayers", fields: [agentId], references: [id])
  guardian               User?                   @relation("GuardianPlayers", fields: [guardianId], references: [id])
  team                   Team?                   @relation(fields: [teamId], references: [id])
  contracts              Contract[]
  transfers              Transfer[]
  injuries               Injury[]
  trainingParticipations TrainingParticipant[]
  trainingResults        TrainingResult[]
  matchStats             PlayerMatchStats[]
  tacticalLineups        TacticalLineup[]
  equipmentAssignments   EquipmentAssignment[]
  prospects              Prospect[]              @relation("ProspectConvertedPlayer")
  medicalExpenses        MedicalExpense[]
  trainingLoads          TrainingLoad[]
  developmentPlans       PlayerDevelopmentPlan[]
  momAnalyses            TacticalAnalysis[]      @relation("MomPlayer")
  improvementAnalyses    TacticalAnalysis[]      @relation("ImprovementPlayer")
  videoAssignments       VideoAssignment[]
  callups                PlayerCallup[]
  playStyle              String?
  // 최신값 캐시 — MarketValueHistory 항목 생성 시 항상 동시 업데이트할 것 (service 레이어에서 트랜잭션 보장)
  currentMarketValue     Float?
  jerseyNumbers          JerseyNumber[]
  marketValueHistory     MarketValueHistory[]
  matchSquads            MatchSquad[]
  lineupSlots            LineupSlot[]
  shotsAsShooter         ShotEvent[] @relation("ShotShooter")
  shotsAsAssister        ShotEvent[] @relation("ShotAssister")
  incidentReports        IncidentReport[]
  growthEvaluations      GrowthEvaluation[]
  badges                 PlayerBadge[]
  academyFees            AcademyFee[]
}

model Contract {
  id          Int            @id @default(autoincrement())
  startDate   DateTime
  endDate     DateTime
  salary      Int
  status      ContractStatus @default(ACTIVE)
  playerId    String
  managedById Int?

  player             Player             @relation(fields: [playerId], references: [id])
  managedBy          User?              @relation(fields: [managedById], references: [id])
  buyoutClause       BuyoutClause?
  extensionOptions   ExtensionOption[]
  performanceBonuses PerformanceBonus[]
}

model BuyoutClause {
  id         Int    @id @default(autoincrement())
  amount     BigInt
  contractId Int    @unique

  contract Contract @relation(fields: [contractId], references: [id])
}

model ExtensionOption {
  id             Int    @id @default(autoincrement())
  condition      String
  durationMonths Int
  contractId     Int

  contract Contract @relation(fields: [contractId], references: [id])
}

model PerformanceBonus {
  id          Int    @id @default(autoincrement())
  amount      BigInt
  description String
  contractId  Int

  contract Contract       @relation(fields: [contractId], references: [id])
  triggers BonusTrigger[]
}

model BonusTrigger {
  id              Int              @id @default(autoincrement())
  metric          BonusMetric
  threshold       Float
  period          BonusPeriod
  competitionType CompetitionType?
  teamScope       BonusTeamScope   @default(ALL)
  bonusId         Int

  bonus PerformanceBonus @relation(fields: [bonusId], references: [id])
}

model Transfer {
  id        Int          @id @default(autoincrement())
  type      TransferType
  date      DateTime
  startDate DateTime?
  endDate   DateTime?
  fee       Int?
  fromClub  String?
  toClub    String?
  playerId  String

  player Player  @relation(fields: [playerId], references: [id])
  recall Recall?
}

model Recall {
  id            Int          @id @default(autoincrement())
  status        RecallStatus @default(PENDING)
  requestedAt   DateTime     @default(now())
  approvedAt    DateTime?
  transferId    Int          @unique
  requestedById Int
  approvedById  Int?

  transfer    Transfer @relation(fields: [transferId], references: [id])
  requestedBy User     @relation("RecallRequestedBy", fields: [requestedById], references: [id])
  approvedBy  User?    @relation("RecallApprovedBy", fields: [approvedById], references: [id])
}

model Partner {
  id        Int         @id @default(autoincrement())
  type      PartnerType
  name      String
  country   String?
  website   String?
  address   String?
  phone     String?
  createdAt DateTime    @default(now())

  injuries       Injury[]
  equipmentItems EquipmentItem[]
  contracts      PartnerContract[]
}

model PartnerContract {
  id             Int                   @id @default(autoincrement())
  partnerId      Int
  status         PartnerContractStatus @default(ACTIVE)
  startDate      DateTime
  endDate        DateTime
  sponsorshipFee Float?
  discountRate   Float?
  notes          String?
  createdAt      DateTime              @default(now())

  partner Partner @relation(fields: [partnerId], references: [id])
}

model EquipmentLoan {
  id              Int                 @id @default(autoincrement())
  status          EquipmentLoanStatus @default(REQUESTED)
  requestedAt     DateTime            @default(now())
  requestedById   Int
  approvedById    Int?
  issuedAt        DateTime?
  returnedAt      DateTime?
  notes           String?
  equipmentItemId Int
  equipmentUnitId Int?

  requestedBy   User           @relation("LoanRequestedBy", fields: [requestedById], references: [id])
  approvedBy    User?          @relation("LoanApprovedBy", fields: [approvedById], references: [id])
  equipmentItem EquipmentItem  @relation(fields: [equipmentItemId], references: [id])
  equipmentUnit EquipmentUnit? @relation(fields: [equipmentUnitId], references: [id])
}

model Injury {
  id                 Int           @id @default(autoincrement())
  bodyPart           BodyPart
  cause              InjuryCause
  expectedReturnDate DateTime?
  status             InjuryStatus  @default(OCCURRED)
  occurredAt         DateTime      @default(now())
  playerId           String
  medicalStaffId     Int
  hospitalType       HospitalType?
  partnerId          Int?
  customHospitalName String?

  player          Player            @relation(fields: [playerId], references: [id])
  medicalStaff    User              @relation(fields: [medicalStaffId], references: [id])
  partner         Partner?          @relation(fields: [partnerId], references: [id])
  medicalExpenses MedicalExpense[]
  injuryReport    InjuryReport?
  assessment      InjuryAssessment?
  externalReports ExternalReport[]
  incidentReports IncidentReport[]
}

model InjuryAssessment {
  id                Int      @id @default(autoincrement())
  injuryId          Int      @unique
  painLevel         Int
  hasSwelling       Boolean  @default(false)
  romScore          Int
  strengthScore     Int
  sprintScore       Int
  jumpScore         Int
  psychScore        Int
  positionRiskScore Int
  medicalScore      Float
  functionalScore   Float
  modifierScore     Float
  totalScore        Float
  assessedAt        DateTime @default(now())
  assessedById      Int

  injury     Injury @relation(fields: [injuryId], references: [id], onDelete: Cascade)
  assessedBy User   @relation(fields: [assessedById], references: [id])
}

enum ExternalReportTarget {
  EDUCATION_OFFICE
  SCHOOL_SAFETY
  LEAGUE
  FEDERATION
  INSURANCE
  POLICE
  CHILD_PROTECTION_AGENCY
  FOOTBALL_ASSOCIATION
}

enum SafeguardReportStatus {
  RECEIVED
  UNDER_REVIEW
  RESOLVED
}

enum ExternalReportStatus {
  PENDING_SUBMISSION
  SUBMITTED
  SUPPLEMENT_REQUESTED
  COMPLETED
}

model ExternalReport {
  id                 Int                  @id @default(autoincrement())
  injuryId           Int?
  incidentReportId   Int?
  safeguardReportId  Int?
  target             ExternalReportTarget
  status             ExternalReportStatus @default(PENDING_SUBMISSION)
  reportData         Json
  dueDate            DateTime?
  submittedAt        DateTime?
  submittedNote      String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  injury         Injury?         @relation(fields: [injuryId], references: [id], onDelete: Cascade)
  incidentReport IncidentReport? @relation(fields: [incidentReportId], references: [id], onDelete: Cascade)

  @@unique([injuryId, target])
  @@unique([incidentReportId, target])
}

model Match {
  id              Int             @id @default(autoincrement())
  date            DateTime
  homeTeamName    String
  awayTeamName    String
  homeScore       Int?
  awayScore       Int?
  competitionType CompetitionType
  venue           Venue?
  externalId      String?         @unique
  seasonId        Int
  teamId          Int?

  season           Season             @relation(fields: [seasonId], references: [id])
  team             Team?              @relation(fields: [teamId], references: [id])
  playerMatchStats PlayerMatchStats[]
  teamMatchStats   TeamMatchStats?
  tacticalAnalyses TacticalAnalysis[]
  squadPlayers     MatchSquad[]
  shotEvents       ShotEvent[]
  matchLineup      MatchLineup?
  incidentReports  IncidentReport[]
}

model PlayerMatchStats {
  id                Int      @id @default(autoincrement())
  goals             Int?
  assists           Int?
  xG                Float?
  xA                Float?
  shots             Int?
  passAccuracy      Float?
  keyPasses         Int?
  tackles           Int?
  tackleSuccessRate Float?
  clearances        Int?
  interceptions     Int?
  saves             Int?
  cleanSheet             Boolean?
  minutesPlayed          Int?
  aerialDuelSuccessRate  Float?
  sprint                 Float?
  clearCutChanceRate     Float?
  penaltyConversionRate  Float?
  freeKickConversionRate Float?
  foulsCommitted         Int?
  crossesCompleted       Int?
  shotsAllowed           Int?
  shotBlocked            Int?
  matchId                Int
  playerId          String

  match  Match  @relation(fields: [matchId], references: [id])
  player Player @relation(fields: [playerId], references: [id])
}

enum ShotResult {
  GOAL
  ON_TARGET
  OFF_TARGET
  BLOCKED
}

model ShotEvent {
  id                       Int        @id @default(autoincrement())
  matchId                  Int
  shooterId                String
  assisterId               String?
  assisterPositionOverride String?
  xG                       Float
  result                   ShotResult
  minute                   Int?

  match    Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  shooter  Player  @relation("ShotShooter",  fields: [shooterId],  references: [id])
  assister Player? @relation("ShotAssister", fields: [assisterId], references: [id])

  @@index([matchId])
}

model TeamMatchStats {
  id            Int   @id @default(autoincrement())
  possession    Int
  shots         Int
  shotsOnTarget Int
  passes        Int
  passAccuracy  Float
  fouls         Int
  yellowCards   Int
  redCards      Int
  xG            Float
  corners       Int
  offsides      Int
  tackles       Int
  interceptions Int
  clearances    Int
  matchId       Int   @unique

  match Match @relation(fields: [matchId], references: [id])
}

model TrainingSession {
  id           Int         @id @default(autoincrement())
  date         DateTime
  goal         String
  sessionType  SessionType
  isApproved   Boolean     @default(false)
  cancelledAt  DateTime?
  createdAt    DateTime    @default(now())
  seasonId     Int
  createdById  Int
  approvedById Int?
  teamId       Int?

  season        Season                @relation(fields: [seasonId], references: [id])
  team          Team?                 @relation(fields: [teamId], references: [id])
  createdBy     User                  @relation("TrainingSessionCreatedBy", fields: [createdById], references: [id])
  approvedBy    User?                 @relation("TrainingSessionApprovedBy", fields: [approvedById], references: [id])
  contents        TrainingContent[]
  participants    TrainingParticipant[]
  results         TrainingResult[]
  trainingLoads   TrainingLoad[]
  incidentReports IncidentReport[]
  playerBadges    PlayerBadge[]
}

model TrainingContent {
  id          Int          @id @default(autoincrement())
  phase       ContentPhase
  description String
  sessionId   Int

  session TrainingSession @relation(fields: [sessionId], references: [id])
}

model TrainingParticipant {
  sessionId Int
  playerId  String

  session TrainingSession @relation(fields: [sessionId], references: [id])
