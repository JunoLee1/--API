// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Type {
  yellow
  red
}

enum Role {
  ADMIN
  SUPER_ADVISOR
  PLAYER
}

enum Foot {
  left
  right
  both
}

enum Position {
  stricker
  shadow_stricker
  winger

  central_attack_middle_fielder
  right_attack_middle_fielder
  left_attack_middle_fielder

  central_defensive_middle_fielder
  left_defensive_middle_fielder
  right_defensive_middle_fielder

  center_back
  left_wing_back
  left_full_back

  right_wing_back
  right_full_back
}

model Season {
  id         Int      @id @default(autoincrement())
  start_date DateTime
  end_Date   DateTime
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  team_season_stats   Team_season_stats[]
  player_season_stats Player_season_stats[]
  season_matches      Match[]
  team_player         Team_player[]
}

model League {
  id   Int    @id @default(autoincrement())
  name String

  nation_id Int
  nation    Country @relation(fields: [nation_id], references: [id])
  teams     Team[]
}

model Country {
  id   Int    @id @default(autoincrement())
  name String @unique
  code String @unique

  users  User[]
  player Player[]
  league League[]
}

model User {
  id            Int      @id @default(autoincrement())
  date_of_birth DateTime
  password      String
  email         String   @unique
  username      String
  nickname      String   @unique
  role          Role

  isDeleted   Boolean 
  country_id  Int
  nationality Country @relation(fields: [country_id], references: [id])
}

model Team {
  id         Int      @id @default(autoincrement())
  team_name  String   @unique
  founded    DateTime
  short_name String   @unique

  league_id Int
  league    League @relation(fields: [league_id], references: [id])

  homeMatches Match[] @relation("HomeTeam")
  awayMatches Match[] @relation("AwayTeam")

  team_season_stats Team_season_stats[]
  goal              Goal[]

  teamPlayers      Team_player[]
  team_match_stats Team_match_stats[]
}

model Match {
  id   Int      @id @default(autoincrement())
  date DateTime

  season_id Int
  season    Season @relation(fields: [season_id], references: [id])

  home_team_id Int
  away_team_id Int
  away_teams   Team @relation("AwayTeam", fields: [away_team_id], references: [id], map: "Match_away_team_fkey")
  home_teams   Team @relation("HomeTeam", fields: [home_team_id], references: [id], map: "Match_home_team_fkey")

  goal Goal[]
  card Card[]

  player_match_stats Player_match_stats[]
  team_match_stats   Team_match_stats[]

  @@map("match")
}

model Player {
  id             String   @id @default(cuid())
  player_name    String
  jersey_number  Int
  position       Position //Todo: fix relation 
  date_of_birth  DateTime
  preferred_foot Foot
  height         Int
  weight         Int
  nation_id      Int
  nation         Country  @relation(fields: [nation_id], references: [id])

  team_player        Team_player[]
  player_match_stats Player_match_stats[]
  goals              Goal[]               @relation(name: "scorer")

  assist Goal[] @relation(name: "assist")

  player_season_stats Player_season_stats[]
  card                Card[]
}

// 집계 테이블
model Team_season_stats {
  season_id Int
  season    Season @relation(fields: [season_id], references: [id])

  team_id Int
  team    Team @relation(fields: [team_id], references: [id])

  @@unique([season_id, team_id])
}

model Player_season_stats {
  id Int @id @default(autoincrement())

  avg_xG                        Int?
  avg_xA                        Int?
  avg_goals                     Int?
  avg_assist                    Int?
  avg_tackle_success_rate       Int?
  avg_passing_accuracy          Int?
  avg_clearance                 Int?
  avg_sprint                    Int?
  avg_clear_cut_chance_rate     Int?
  games_played                  Int?
  goals_per_game                Int?
  avg_fouls_commited            Int?
  avg_shot_allowed              Int?
  avg_shot_blocked              Int?
  avg_crosses_completed         Int?
  avg_penalty_conversion_rate   Int?
  avg_interception              Int?
  avg_free_kick_conversion_rate Int?

  season_id Int
  season    Season @relation(fields: [season_id], references: [id])

  player_id String
  player    Player @relation(fields: [player_id], references: [id])

  @@unique([season_id, player_id])
}

model Player_match_stats {
  id                        Int  @id @default(autoincrement())
  xG                        Int?
  xA                        Int?
  goals                     Int?
  assist                    Int?
  tackle_success_rate       Int?
  passing_accuracy          Int?
  clearance                 Int?
  sprint                    Int?
  clear_cut_chance_rate     Int?
  fouls_commited            Int?
  shot_allowed              Int?
  shot_blocked              Int?
  crosses_completed         Int?
  penalty_conversion_rate   Int?
  interception              Int?
  free_kick_conversion_rate Int?

  match_id Int
  match    Match @relation(fields: [match_id], references: [id])

  player_id String
  player    Player @relation(fields: [player_id], references: [id])
}

model Team_match_stats {
  id               Int @id @default(autoincrement())
  possesion        Int
  shots            Int
  shots_on_target  Int
  shots_off_target Int
  key_passess      Int
  passes           Int
  pass_accuracy    Int
  fouls            Int
  yellow_cards     Int
  red_cards        Int
  xG               Int
  corners          Int
  offsides         Int
  tackles          Int
  interceptions    Int
  clearances       Int
  blocked_shots    Int

  team_id Int
  team    Team @relation(fields: [team_id], references: [id])

  match_id Int
  match    Match @relation(fields: [match_id], references: [id])

  @@unique([team_id, match_id])
}

model Goal {
  id       Int   @id @default(autoincrement())
  match_id Int
  match    Match @relation(fields: [match_id], references: [id])

  scorer_id String
  scorer    Player @relation(fields: [scorer_id], references: [id], name: "scorer")

  assist_id String
  assist    Player @relation(fields: [assist_id], references: [id], name: "assist")

  team_id Int
  team    Team @relation(fields: [team_id], references: [id])
}

model Card {
  id      Int  @id @default(autoincrement())
  type    Type
  minutes Int

  match_id Int
  match    Match @relation(fields: [match_id], references: [id])

  player_id String
  player    Player @relation(fields: [player_id], references: [id])
}

// connect

model Team_player {
  season_id Int
  season    Season @relation(fields: [season_id], references: [id])

  team_id Int
  team    Team @relation(fields: [team_id], references: [id])

  player_id String
  player    Player @relation(fields: [player_id], references: [id])

  @@id([team_id, player_id, season_id])
}
