# PostgreSQL password (used by db service and auto-composed into DATABASE_URL)
DB_PASSWORD=change_me_strong_password

# CORS allowed origin — set to your domain or server IP
# e.g. http://YOUR_SERVER_IP  or  https://yourdomain.com
CLIENT_ORIGIN=http://YOUR_SERVER_IP

# JWT secrets — generate with: openssl rand -hex 32
JWT_ACCESS_TOKEN_SECRET=change_me_access_secret
JWT_REFRESH_TOKEN_SECRET=change_me_refresh_secret

# Phone encryption key — must be exactly 64 hex chars (32 bytes)
# generate with: openssl rand -hex 32
PHONE_ENCRYPTION_KEY=change_me_64hex_chars_exactly_here_0000000000000000000000000000000

# Anthropic API key (optional — only needed for AI features)
ANTHROPIC_API_KEY=
